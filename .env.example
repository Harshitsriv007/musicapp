# Copy to .env (`make config` does this) and adjust. docker compose reads .env automatically.

# --- MySQL ---
DB_PASSWORD=musicapp
DB_ROOT_PASSWORD=rootpass

# --- Song ingestion (cron → Kafka → MySQL) ---
# Spring cron (sec min hour day month weekday). "-" disables the schedule.
INGESTION_CRON=0 */15 * * * *
INGESTION_RUN_ON_STARTUP=true
INGESTION_QUERIES=bollywood,hindi songs,arijit singh,bollywood romantic,punjabi

# --- Downloads (audio stored in MySQL) ---
# Songs stream live from the music API; only songs downloaded with the UI button are stored.
# Largest audio file stored per song, in bytes (100 MB).
DOWNLOAD_MAX_BYTES=104857600

# --- Original release years for decade folders (MusicBrainz, free, ~1 lookup/second) ---
ENRICHMENT_ENABLED=true
# MusicBrainz asks clients to identify themselves – add a contact URL or email if you run this publicly.
MUSICBRAINZ_USER_AGENT=DhunMusicApp/1.0 ( self-hosted )

# --- Optional second music source (free key: https://developer.jamendo.com) ---
JAMENDO_ENABLED=false
JAMENDO_CLIENT_ID=
